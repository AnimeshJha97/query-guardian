# Copy this file to .env before running Docker Compose.
# Never commit the resulting .env file.

# Argon2id hash of the admin login password.
# Generate one with:
# node -e "require('argon2').hash(process.argv[1]).then(console.log)" "your-password"
QG_ADMIN_PASSWORD_HASH=replace_with_argon2id_hash

# Random session-signing secret, at least 32 characters.
QG_SESSION_SECRET=replace_with_random_secret_at_least_32_chars

# Random credential shared by the API and collector.
QG_INGEST_TOKEN=replace_with_random_ingest_token

# Exactly 32 bytes, encoded as base64url, base64, or hex.
# Generate one with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
QG_ENCRYPTION_KEY=replace_with_generated_encryption_key
