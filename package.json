{
  "name": "query-guardian",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/core",
    "packages/collector",
    "packages/api",
    "packages/dashboard"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm run dev --workspace=packages/api",
    "dev:collector": "npm run dev --workspace=packages/collector",
    "dev:dashboard": "npm run dev --workspace=packages/dashboard",
    "db:migrate": "npm run db:migrate --workspace=packages/api",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "typecheck": "npm run build --workspace=packages/core && npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.54.1",
    "eslint": "^9.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
